{
  "name": "claude-code-on-mac",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "在 macOS 上配置和检查 Claude Code 工作环境",
  "engines": { "node": ">=20" },
  "scripts": {
    "preview": "node scripts/setup.mjs preview",
    "setup": "node scripts/setup.mjs install",
    "preview:relay": "node scripts/setup.mjs preview --relay",
    "setup:relay": "node scripts/setup.mjs install --relay",
    "undo": "node scripts/setup.mjs uninstall",
    "test": "node --test && python3 tests/test_relay.py"
  },
  "dependencies": { "jsonc-parser": "3.3.1" }
}
